---
import Logo from './Logo.astro';
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-top">
      <div class="footer-brand">
        <Logo height={50} light />
        <p class="footer-tagline">Fundación de Ideas Liberales</p>
        <p class="footer-slogan">#ElFuturoEsLiberal</p>
      </div>

      <div class="footer-nav">
        <h4>Navegación</h4>
        <ul>
          <li><a href="#inicio">Inicio</a></li>
          <li><a href="#nosotros">Nosotros</a></li>
          <li><a href="#hacemos">Qué hacemos</a></li>
          <li><a href="#eventos">Eventos</a></li>
          <li><a href="#contacto">Contacto</a></li>
        </ul>
      </div>

      <div class="footer-contact">
        <h4>Contacto</h4>
        <ul>
          <li>Santa Cruz de la Sierra, Bolivia</li>
          <li>+591 69875278</li>
          <li>contacto@riodelibertad.com</li>
        </ul>
      </div>

      <div class="footer-social">
        <h4>Síguenos</h4>
        <div class="footer-social-links">
          <a href="#" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
              <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
            </svg>
          </a>
          <a href="#" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </a>
          <a href="#" aria-label="X">
            <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; 2026 Río de Libertad. Todos los derechos reservados.</p>
      <div class="footer-bottom-links">
        <a href="#">Política de privacidad</a>
        <span>&middot;</span>
        <a href="#">Términos de uso</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--charcoal);
    color: rgba(255, 255, 255, 0.6);
    padding: 4rem 1.5rem 1.5rem;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 1.5rem;
  }

  .footer-tagline {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 0.3rem;
  }

  .footer-slogan {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.1rem;
    color: var(--gold-primary);
    letter-spacing: 0.1em;
  }

  .footer h4 {
    font-size: 1.1rem;
    color: var(--white);
    text-transform: uppercase;
    margin-bottom: 1.2rem;
    letter-spacing: 0.05em;
  }

  .footer ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer ul li,
  .footer ul a {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.4);
    transition: color 0.3s;
  }

  .footer ul a:hover {
    color: var(--gold-primary);
  }

  .footer-social-links {
    display: flex;
    gap: 0.8rem;
  }

  .footer-social-links a {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.4);
    transition: all 0.3s;
  }

  .footer-social-links a:hover {
    border-color: var(--gold-primary);
    color: var(--gold-primary);
    background: rgba(224, 178, 25, 0.1);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    opacity: 0.5;
    padding-top: 0.5rem;
  }

  .footer-bottom-links {
    display: flex;
    gap: 0.5rem;
  }

  .footer-bottom-links a {
    transition: color 0.3s;
  }

  .footer-bottom-links a:hover {
    color: var(--gold-primary);
  }

  @media (max-width: 768px) {
    .footer {
      padding: 3rem 1.5rem 1.5rem;
    }

    .footer-top {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .footer-bottom {
      flex-direction: column;
      text-align: center;
      gap: 0.5rem;
    }

    .footer-bottom-links {
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
