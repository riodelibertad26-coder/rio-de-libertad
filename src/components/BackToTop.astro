---

<button class="back-to-top" id="backToTop" aria-label="Volver arriba">
  <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="18 15 12 9 6 15"/>
  </svg>
  <svg class="progress-ring" viewBox="0 0 52 52">
    <circle class="progress-ring-bg" cx="26" cy="26" r="24" fill="none" stroke="rgba(224,178,25,0.15)" stroke-width="2.5"/>
    <circle class="progress-ring-fill" cx="26" cy="26" r="24" fill="none" stroke="#E0B219" stroke-width="2.5"
      stroke-dasharray="150.8" stroke-dashoffset="150.8" stroke-linecap="round" transform="rotate(-90 26 26)"/>
  </svg>
</button>

<style>
  .back-to-top {
    position: fixed;
    bottom: 2rem;
    left: 2rem;
    width: 48px;
    height: 48px;
    background: var(--charcoal);
    color: var(--gold-primary);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: grid;
    place-items: center;
    z-index: 900;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s, visibility 0.4s, transform 0.3s, background 0.3s, color 0.3s;
    padding: 0;
  }

  .back-to-top.visible {
    opacity: 1;
    visibility: visible;
  }

  .back-to-top:hover {
    background: var(--gold-primary);
    color: var(--charcoal);
    transform: translateY(-3px);
  }

  .arrow-icon {
    width: 18px;
    height: 18px;
    grid-area: 1 / 1;
    z-index: 1;
  }

  .progress-ring {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  @media (max-width: 480px) {
    .back-to-top {
      width: 42px;
      height: 42px;
      bottom: 1.2rem;
      left: 1.2rem;
    }

    .arrow-icon {
      width: 15px;
      height: 15px;
    }
  }
</style>

<script>
  const btn = document.getElementById('backToTop');
  const fill = document.querySelector('.progress-ring-fill') as SVGCircleElement;
  const circumference = 150.8;

  window.addEventListener('scroll', () => {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const scrollPercent = scrollTop / docHeight;

    btn?.classList.toggle('visible', scrollTop > 400);

    if (fill) {
      fill.style.strokeDashoffset = String(circumference - (scrollPercent * circumference));
    }
  });

  btn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
