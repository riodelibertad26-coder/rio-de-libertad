      <span class="marquee-dot"></span>
    </div>
    <div class="marquee-content" aria-hidden="true">
      <span>Libertad</span>
      <span class="marquee-dot"></span>
      <span>Pensamiento Crítico</span>
      <span class="marquee-dot"></span>
      <span>Debate Abierto</span>
      <span class="marquee-dot"></span>
