<section class="section contacto" id="contacto">
  <div class="container">
    <div class="contacto-grid">
      <div class="contacto-info reveal-left">
        <div class="gold-line"></div>
        <h2 class="section-title">Contacto</h2>
        <p class="contacto-lead">
          ¿Querés ser parte del cambio? ¿Tenés alguna consulta?
          Escribinos y nos pondremos en contacto contigo.
        </p>

        <div class="contacto-datos">
          <div class="dato">
            <div class="dato-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="22" height="22">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <div>
              <strong>Ubicación</strong>
              <p>Santa Cruz de la Sierra, Bolivia</p>
            </div>
          </div>
          <div class="dato">
            <div class="dato-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="22" height="22">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
            </div>
            <div>
              <strong>Email</strong>
              <p>contacto@riodelibertad.com</p>
            </div>
          </div>
          <div class="dato">
            <div class="dato-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="22" height="22">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </div>
            <div>
              <strong>Teléfono</strong>
              <p>+591 69875278</p>
            </div>
          </div>
        </div>

        <div class="contacto-social">
          <a href="#" class="social-link" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
              <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
            </svg>
          </a>
          <a href="#" class="social-link" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </a>
          <a href="#" class="social-link" aria-label="X / Twitter">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <a href="#" class="social-link" aria-label="WhatsApp">
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </a>
        </div>
      </div>

      <div class="contacto-form-wrapper reveal-right">
        <form class="contacto-form" id="contactForm">
          <div class="form-row">
            <div class="form-group">
              <label for="nombre">Nombre</label>
              <input type="text" id="nombre" placeholder="Tu nombre" required />
            </div>
            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" placeholder="Tu email" required />
            </div>
          </div>
          <div class="form-group">
            <label for="asunto">Asunto</label>
            <input type="text" id="asunto" placeholder="¿Sobre qué nos escribís?" />
          </div>
          <div class="form-group">
            <label for="mensaje">Mensaje</label>
            <textarea id="mensaje" rows="5" placeholder="Tu mensaje" required></textarea>
          </div>
          <button type="submit" class="btn btn-submit">
            <span>Enviar mensaje</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
              <line x1="22" y1="2" x2="11" y2="13"/>
              <polygon points="22 2 15 22 11 13 2 9 22 2"/>
            </svg>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contacto {
    background: var(--bg-secondary);
  }

  .contacto-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .contacto-lead {
    font-size: 1.1rem;
    color: var(--text-secondary);
    font-weight: 300;
    line-height: 1.8;
    margin-bottom: 2.5rem;
  }

  .contacto-datos {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .dato {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .dato-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(224, 178, 25, 0.1);
    color: var(--gold-primary);
    flex-shrink: 0;
  }

  .dato strong {
    display: block;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.1rem;
    letter-spacing: 0.05em;
    margin-bottom: 0.2rem;
    color: var(--text-heading);
  }

  .dato p {
    font-size: 0.95rem;
    color: var(--text-muted);
    font-weight: 300;
  }

  .contacto-social {
    display: flex;
    gap: 0.8rem;
  }

  .social-link {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-color);
    color: var(--text-heading);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .social-link:hover {
    background: var(--gold-primary);
    border-color: var(--gold-primary);
    color: var(--white);
    transform: translateY(-3px);
  }

  .contacto-form {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    background: var(--bg-card);
    padding: 2.5rem;
    box-shadow: 0 10px 40px var(--card-shadow);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group label {
    display: block;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    color: var(--text-heading);
    margin-bottom: 0.4rem;
  }

  .contacto-form input,
  .contacto-form textarea {
    width: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid var(--border-color);
    background: var(--input-bg);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    color: var(--text-body);
    transition: all 0.3s;
    outline: none;
  }

  .contacto-form input:focus,
  .contacto-form textarea:focus {
    border-color: var(--gold-primary);
    background: var(--bg-card);
    box-shadow: 0 0 0 3px rgba(224, 178, 25, 0.1);
  }

  .contacto-form textarea {
    resize: vertical;
  }

  .btn-submit {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.1rem;
    letter-spacing: 0.1em;
    padding: 1rem 2rem;
    background: var(--charcoal);
    color: var(--white);
    border: 2px solid var(--charcoal);
    cursor: pointer;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: all 0.4s;
    width: 100%;
  }

  .btn-submit:hover {
    background: var(--gold-primary);
    border-color: var(--gold-primary);
    color: var(--charcoal);
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(224, 178, 25, 0.25);
  }

  @media (max-width: 768px) {
    .contacto-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
